{
  "name": "termix",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "giiiiiit": "git reset --hard HEAD && git clean -fd"
  },
  "build": {
    "appId": "com.termix.app",
    "productName": "Termix",
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    },
    "mac": {
      "target": "dmg"
    }
  },
  "dependencies": {
    "kubitdb": "^1.5.5",
    "node-machine-id": "^1.1.12",
    "node-pty": "^1.1.0",
    "serialport": "^13.0.0",
    "ssh2": "^1.15.0",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0",
    "xterm-addon-webgl": "^0.16.0"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  }
}
