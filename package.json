{
  "name": "Termix",
  "version": "1.0.0",
  "description": "A modern terminal & SSH client",
  "author": "DeveloperKubilay",
  "repository": {
    "type": "git",
    "url": "https://github.com/DeveloperKubilay/termix.git"
  },
  "main": "index.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "site:preview": "node website/server.js",
    "giiiiiit": "git reset --hard HEAD && git clean -fd"
  },
  "build": {
    "appId": "com.Termix.app",
    "productName": "Termix",
    "icon": "public/icons/512.png",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "DeveloperKubilay",
        "repo": "termix",
        "releaseType": "release"
      }
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Termix"
    },
    "win": {
      "target": "nsis",
      "icon": "public/icons/favicon.ico"
    },
    "linux": {
      "target": "AppImage"
    },
    "mac": {
      "target": "dmg"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.3",
    "firebase": "^12.10.0",
    "kubitdb": "^1.5.5",
    "node-machine-id": "^1.1.12",
    "node-pty": "^1.1.0",
    "serialport": "^13.0.0",
    "ssh2": "^1.15.0",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0",
    "xterm-addon-webgl": "^0.16.0"
  },
  "optionalDependencies": {
    "dmg-license": "^1.0.11"
  },
  "devDependencies": {
    "electron": "^40.6.1",
    "electron-builder": "^26.8.1"
  }
}
