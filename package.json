{
  "name": "Termix",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "giiiiiit": "git reset --hard HEAD && git clean -fd"
  },
  "build": {
    "appId": "com.Termix.app",
    "productName": "Termix",
    "directories": {
      "output": "dist"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Termix"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    },
    "mac": {
      "target": "dmg"
    }
  },
  "dependencies": {
    "firebase": "^12.10.0",
    "kubitdb": "^1.5.5",
    "node-machine-id": "^1.1.12",
    "node-pty": "^1.1.0",
    "serialport": "^13.0.0",
    "ssh2": "^1.15.0",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0",
    "xterm-addon-webgl": "^0.16.0"
  },
  "devDependencies": {
    "electron": "^40.6.1",
    "electron-builder": "^24.9.1"
  }
}
